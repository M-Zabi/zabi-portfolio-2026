# Copy to .env.local and fill in.

# Where the contact form POSTs JSON (Formspree, a serverless function, your own API).
# Leave empty to fall back to a pre-filled mailto: link. Résumé requests are POSTed here too
# (with "intent": "resume") so you know who downloaded it.
VITE_CONTACT_ENDPOINT=

# Blog hearts & comments API — see src/services/engagement.ts for the three routes it needs.
# Leave empty and hearts/comments are kept in each visitor's browser only.
VITE_ENGAGEMENT_ENDPOINT=

# Streams a live AI summary of a post — see src/services/summary.ts. Keep the model API key on
# that server. Leave empty to stream the summary written for each post.
VITE_SUMMARY_ENDPOINT=

# Canonical site origin used in meta tags.
VITE_SITE_URL=https://example.com
